      "test": "test_traceability.py::test_valid_manifest_passes"
    },
    {
      "id": "TRACE-MISSING",
      "kind": "실패",
      "rule": "화면·규칙 ID의 누락/중복/잘못된 연결, 구현·테스트 파일의 부재를 모두",
      "test": "test_traceability.py::test_missing_rule_and_file_are_reported"
    },
    {
      "id": "TRACE-DUP-WRONG",
      "kind": "실패",
      "rule": "화면·규칙 ID의 누락/중복/잘못된 연결, 구현·테스트 파일의 부재를 모두",
      "test": "test_traceability.py::test_wrong_screen_and_duplicate_rule_are_reported"
    },
    {
      "id": "ROUTE-OBJ",
      "kind": "정상",
      "rule": "`화면`은 route object에",
      "test": "test_traceability.py::test_route_object_syntax_is_read"
    },
    {
      "id": "ROUTE-UNREG",
      "kind": "실패",
      "rule": "등록되지 않은 화면은 빌드가 통과하고 그 URL 에서만 빈 화면이 된다.",
      "test": "test_traceability.py::test_unregistered_route_is_reported"
