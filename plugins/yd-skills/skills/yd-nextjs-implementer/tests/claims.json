    {
      "id": "PORT-FREE",
      "kind": "정상",
      "rule": "포트가 막히면 프레임워크가 조용히 다른 포트로 옮겨",
      "test": "test_serve_and_check.py::test_free_port_is_used_as_is"
    },
    {
      "id": "PORT-BUSY",
      "kind": "경계",
      "rule": "포트가 막히면 프레임워크가 조용히 다른 포트로 옮겨",
      "test": "test_serve_and_check.py::test_busy_port_moves_up"
    },
    {
      "id": "SERVE-HEALTHY",
      "kind": "정상",
      "rule": "확인된 포트만 사용자에게 알린다.",
      "test": "test_serve_and_check.py::test_healthy_server_passes_and_is_stopped"
    },
    {
      "id": "SERVE-404",
      "kind": "실패",
      "rule": "손으로 하지 말고 스크립트로 판정한다",
      "test": "test_serve_and_check.py::test_missing_route_fails"
    },
    {
      "id": "SERVE-NOLISTEN",
      "kind": "도구오류",
      "rule": "손으로 하지 말고 스크립트로 판정한다",
      "test": "test_serve_and_check.py::test_server_that_never_listens_fails"
    },
    {
      "id": "SERVE-PLACEHOLDER",
      "kind": "정상",
      "rule": "--cmd \"pnpm dev -- --port {port}\"",
      "test": "test_serve_and_check.py::test_port_placeholder_is_substituted"
    }
  ]
