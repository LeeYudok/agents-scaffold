      "rule": "화면 ID 를 키로 화면마다 4개 절",
      "test": "test_contract.py::test_br_sections_exist_in_planner"
    },
    {
      "id": "FILENAME-PATTERNS",
      "kind": "정상",
      "rule": "*_business-rules.md",
      "test": "test_contract.py::test_deliverable_filename_patterns_match_planner"
    },
    {
      "id": "JAVA8-VERSION",
      "kind": "정상",
      "rule": "Java 8 언어 수준을 지킨다.",
      "test": "test_contract.py::test_java_version_is_consistent"
    },
    {
      "id": "SPRING-27",
      "kind": "실패",
      "rule": "Spring Boot 2.7.x(지원 마지막 2.x)",
      "test": "test_contract.py::test_spring_boot_line_is_java8_compatible"
    },
    {
      "id": "TWO-MODES",
      "kind": "정상",
      "rule": "**Vite + React SPA** 두 가지다.",
      "test": "test_contract.py::test_two_frontend_modes_and_owners_are_explicit"
    },
    {
      "id": "MODES-REF",
      "kind": "정상",
      "rule": "[references/implementation-modes.md](references/implementation-modes.md)",
      "test": "test_contract.py::test_mode_reference_and_traceability_contract_exist"
    },
    {
      "id": "REFS-EXIST",
      "kind": "실패",
      "rule": "[references/implementation-modes.md](references/implementation-modes.md)",
      "test": "test_contract.py::test_linked_references_exist"
    },
    {
      "id": "SERVE-WIRED",
      "kind": "정상",
      "rule": "`serve_and_check.py` 가 exit 0 이 아니면 완료가 아니다.",
      "test": "test_contract.py::test_serve_and_check_is_wired"
    },
    {
      "id": "SMB-PLANNER-FIRST",
      "kind": "실패",
