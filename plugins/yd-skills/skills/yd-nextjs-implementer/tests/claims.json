    {
      "id": "ROUTE-ORPHAN",
      "kind": "실패",
      "rule": "문서에만 있는 라우트와 라우터에만 있는 라우트를 양방향으로 보고한다.",
      "test": "test_traceability.py::test_orphan_route_in_router_is_reported"
    },
    {
      "id": "ROUTE-CATCHALL",
      "kind": "오탐",
      "rule": "index는 화면 ID를 갖지 않으므로 대조 대상이 아니다.",
      "test": "test_traceability.py::test_catch_all_is_not_an_orphan"
    },
    {
      "id": "OVERLAY-NOROUTE",
      "kind": "오탐",
      "rule": "오버레이는 라우트를 갖지 않으므로 `traceability.json`에 `route`를",
      "test": "test_traceability.py::test_overlay_screens_without_route_are_untouched"
