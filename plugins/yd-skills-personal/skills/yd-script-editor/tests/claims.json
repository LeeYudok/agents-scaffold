    {"id": "CONF-FIND", "kind": "정상", "rule": "설정 파일은 현재 폴더에서 위로 올라가며 찾는다", "test": "test_script_editor.py::test_find_walks_up_from_cwd"},
    {"id": "CONF-HOME", "kind": "정상", "rule": "`~/` 는 홈으로 편다", "test": "test_script_editor.py::test_tilde_expands_to_home"},
