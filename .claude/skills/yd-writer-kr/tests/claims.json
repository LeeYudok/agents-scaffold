    {"id": "ROW-THREE-COLS", "kind": "실패", "rule": "이 파일이 금지 표현의 유일한 원본이다.", "test": "test_check_writing.py::test_every_row_has_check_column"},
    {"id": "ESCAPED-PIPE", "kind": "경계", "rule": "정규식 안의 `|` 는 표 구분자와 겹치므로 `\\|` 로 적는다.", "test": "test_check_writing.py::test_escaped_pipe_is_alternation"},
