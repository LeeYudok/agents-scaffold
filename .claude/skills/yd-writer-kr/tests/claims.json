    {"id": "SELF-CHECK", "kind": "정상", "rule": "문어체 산출물에 ~함·~임·~됨 종결이 없다(채팅은 예외).", "test": "test_check_writing.py::test_skill_docs_pass"},
    {"id": "SECRET-BLOCK", "kind": "실패", "rule": "시크릿처럼 보이는 문자열이 있으면 스크립트가 멈춘다.", "test": "test_check_writing.py::test_secret_is_not_sent"},
    {"id": "MISSING-KEY", "kind": "도구오류", "rule": "키가 없으면 이 단계를 건너뛰고 직접 고친다.", "test": "test_check_writing.py::test_missing_key"},
    {"id": "DOC-STYLE", "kind": "경계", "rule": "~합니다 체도 쓸 수 있다", "test": "test_check_writing.py::test_doc_style_follows_majority_ending"},
