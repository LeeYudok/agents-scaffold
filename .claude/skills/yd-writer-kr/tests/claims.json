    {"id": "SUMMARY-RETRY-KEEP", "kind": "정상", "rule": "그래도 줄 수가 넘치면 앞에서 `--lines` 줄만 남긴다.", "test": "test_check_writing.py::test_retry_on_source_errors_then_keep_first_lines"},
    {"id": "SUMMARY-CHUNKS", "kind": "경계", "rule": "원문이 12,000자를 넘으면 단락 경계에서 나눠 부분 요약을 만든 뒤 합쳐 다시 요약한다.", "test": "test_check_writing.py::test_long_source_is_summarized_in_parts"}
  ]
