{
  "claims": [
    {"id": "PALETTE-SHIPPED", "kind": "정상", "rule": "팔레트는 `assets/palettes.json` 에 세 벌 있다.", "test": "test_visual_brief.py::test_every_shipped_palette_passes"},
    {"id": "CONTRAST", "kind": "실패", "rule": "본문 글자 7 이상, 보조 글자와 강조색 4.5 이상, 경고색 3 이상", "test": "test_visual_brief.py::test_low_contrast_text_is_an_error"},
    {"id": "HUE-GAP", "kind": "실패", "rule": "강조색과 경고색의 색상 차 60도 이상", "test": "test_visual_brief.py::test_accent_and_signal_must_differ_in_hue"},
    {"id": "TWO-HUES", "kind": "실패", "rule": "유채색은 강조색과 경고색 두 계열만 쓴다.", "test": "test_visual_brief.py::test_third_hue_is_an_error"},
    {"id": "SVG-FONT", "kind": "실패", "rule": "SVG 글자는 11px 이상으로 쓴다.", "test": "test_visual_brief.py::test_small_svg_text_is_an_error"},
    {"id": "NO-EMOJI", "kind": "실패", "rule": "이모지를 아이콘으로 쓰지 않는다.", "test": "test_visual_brief.py::test_emoji_is_an_error"},
    {"id": "NO-CAPTURE", "kind": "실패", "rule": "화면 캡처 이미지를 넣지 않는다.", "test": "test_visual_brief.py::test_screenshot_image_is_an_error"},
    {"id": "ARCH-REQUIRED", "kind": "실패", "rule": "전체 시스템 구성도가 핵심이다.", "test": "test_visual_brief.py::test_missing_architecture_is_an_error"},
    {"id": "ONE-H1", "kind": "실패", "rule": "h1 이 하나다", "test": "test_visual_brief.py::test_two_h1_is_an_error"},
    {"id": "OFFLINE", "kind": "정상", "rule": "틀(`assets/template.html`)은 외부 자원을 불러오지 않는다.", "test": "test_visual_brief.py::test_template_loads_nothing_external"},
    {"id": "EXTERNAL-WARN", "kind": "경계", "rule": "외부 주소를 불러오지 않는다", "test": "test_visual_brief.py::test_external_resource_is_a_warning"},
    {"id": "OUTSIDE-BOUNDARY", "kind": "경계", "rule": "경계 밖 시스템 하나.", "test": "test_visual_brief.py::test_architecture_puts_outside_system_beyond_the_boundary"},
    {"id": "CUT-LINE", "kind": "정상", "rule": "뺀 이유가 있으면 경고색 점선", "test": "test_visual_brief.py::test_metro_draws_a_cut_line_dashed_in_signal_colour"},
    {"id": "EXIT-CODES", "kind": "도구오류", "rule": "종료 코드는 오류가 없으면 0, 있으면 1, 사용법이나 파일 문제면 2 다.", "test": "test_visual_brief.py::test_missing_file_exits_two"},
    {"id": "EXAMPLE-CLEAN", "kind": "정상", "rule": "예제는 `assets/example/brief.json` 에 있다.", "test": "test_visual_brief.py::test_example_builds_clean"}
  ]
}
